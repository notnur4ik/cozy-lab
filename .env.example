# ==============================================================================
# COZY LAB — Environment Variables Example
# Designed and developed by NOVEN.CODE
#
# NEVER commit real secrets to version control.
# NEVER put private keys, service-role keys, or secrets into NEXT_PUBLIC_* vars.
# ==============================================================================

# Public Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Public Configuration (Safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Configuration (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Security Secrets (Server-Only, minimum 32 random bytes hex/base64)
REPLAY_HMAC_SECRET=replace-with-64-char-random-hex-secret
CRON_SECRET=replace-with-64-char-random-hex-secret

# WhatsApp Business Cloud API (Optional — Server-Only)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Public WhatsApp fallback number for Method B click-to-chat (E.164 without +)
NEXT_PUBLIC_WHATSAPP_FALLBACK_PHONE=

# 2GIS Maps Integration (Optional)
NEXT_PUBLIC_2GIS_API_KEY=

# Email / SMS Notifications (Optional — Server-Only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@cozylab.kz
